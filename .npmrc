# إصلاح مشكلة npm install على Railway
#
# Baileys 7.x يفعّل hasInstallScript=true داخل package.json مما يجبر npm
# على تشغيل node-gyp/scrypt الأصلي في مرحلة postinstall. هذا يستهلك
# ذاكرة Railway حتى تصل إشارة SIGTERM ويتوقف تثبيت npm بالكامل.
# نُلغي السكربتات لكل الحزم لأنه لا توجد ميزة أصلية تُستخدم فعلاً —
# @whiskeysockets/baileys و libsignal يعملان عبر WASM/JS خالص.
ignore-scripts=true
fund=false
audit=false
loglevel=warn
fetch-retries=3
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=300000

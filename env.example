# توكن بوت تيليجرام من @BotFather (إلزامي)
TELEGRAM_TOKEN=ضع_توكن_البوت_هنا

# ids المستخدمين المسموح لهم فقط (افصل بينهم بفاصلة) - اتركه فارغاً للسماح للجميع
ADMIN_IDS=

# true = فقط الـ ids أعلاه يستطيعون استخدام هذا البوت | false = الجميع
ONLY_ADMINS=false

# رابط قاعدة MongoDB لحفظ بيانات البوت والجلسات بشكل دائم
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# اسم قاعدة البيانات داخل MongoDB
MONGODB_DB_NAME=fares_bot

# حجم تجمّع اتصالات MongoDB - مفضل رفعه عند استخدام أعداد كبيرة من الجلسات
MONGO_POOL_SIZE=80

# وضع حفظ الجلسات: database = قاعدة البيانات فقط | local = محلي فقط
SESSION_STORAGE_MODE=database

# كتابة نسخة محلية من حالة البوت (اختياري) - يفضل false على Railway
WRITE_LOCAL_STATE_CACHE=false

# مسار ملف قاعدة البيانات المحلية الاحتياطية (JSON) عند تفعيل WRITE_LOCAL_STATE_CACHE
DB_FILE=./data/db.json

# مجلد جلسات واتساب المحلي - يستخدم فقط عند SESSION_STORAGE_MODE=local
SESSIONS_DIR=./sessions

# مهلة تجميع وحفظ تحديثات الحالة في قاعدة البيانات بالمللي ثانية
DB_WRITE_DEBOUNCE_MS=800

# منفذ تشغيل الموقع
PORT=3000

# رابط الموقع النهائي بعد النشر - مهم ليظهر داخل الرسائل التلقائية
WEBSITE_URL=https://your-domain.com

# رابط بوت تيليجرام
TELEGRAM_BOT_URL=https://t.me/Faresw_bob

# عنوان ووصف الموقع
SITE_TITLE=Fares Bot
SITE_DESCRIPTION=منصة رسمية لعرض خدمات البوت والإحصائيات والتعليقات

# رمز دخول لوحة المطور في الموقع
SITE_ADMIN_TOKEN=change-this-admin-token

# الحد الأعلى للتعليقات المعروضة في الواجهة العامة
MAX_PUBLIC_COMMENTS=50

# ids المطور ورقمه وروابطه الرسمية
DEVELOPER_ID=7231690686
DEVELOPER_WHATSAPP=967773987296
DEVELOPER_WHATSAPP_URL=https://wa.me/967773987296
WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/0029Vb8jjfWCRs1sVz0x1w3v
WHATSAPP_CHANNEL_INVITE=0029Vb8jjfWCRs1sVz0x1w3v

# التفاعل على الحالات فوراً بدون تأخير مقصود
REACT_DELAY_MIN=0
REACT_DELAY_MAX=0

# أقصى عمر للحالة المقبولة للتفاعل بالمللي ثانية
MAX_STATUS_AGE_MS=45000

# لا تعالج سجل الحالات التاريخي عند الإقلاع إلا إذا احتجت ذلك
PROCESS_HISTORY_STATUSES=true
HISTORY_STATUS_MAX_AGE_MS=172800000
STATUS_RECOVERY_MAX_AGE_MS=172800000
STATUS_RECOVERY_FLUSH_LIMIT=25

# عدد الجلسات التي يتم استعادتها بالتوازي عند التشغيل
RESUME_CONCURRENCY=12
RESUME_BATCH_DELAY_MS=250

# مستوى السجلات: silent | error | warn | info | debug
STATUS_REACTION_MAX_RETRIES=240
STATUS_REACTION_REQUEUE_INTERVAL_MS=5000

LOG_LEVEL=warn

# تنزيل فيديوهات تيك توك وإنستغرام داخل الرقم المربوط
MEDIA_DOWNLOAD_DIR=./tmp-downloads
MEDIA_MAX_SIZE_MB=64
MEDIA_DOWNLOAD_TIMEOUT_MS=180000
MEDIA_REQUEST_TIMEOUT_MS=25000
MEDIA_FETCH_CACHE_TTL_MS=900000
MEDIA_WARMUP_INTERVAL_MS=900000
# اختياري: إذا كنت تريد استخدام مسار yt-dlp جاهز على الخادم
YT_DLP_BINARY_PATH=
# إعدادات استخراج تيك توك عبر tiktokio
TIKTOK_SOURCE_PREFIX=tiktokio.com
TIKTOK_SOURCE_SITE=https://tiktokio.com/
TIKTOK_SOURCE_API=https://tiktokio.com/api/v1/tk/html
# اختياري: كوكيز إنستغرام لتحسين دعم بعض الروابط العامة الصعبة
INSTAGRAM_SESSIONID=
INSTAGRAM_COOKIES=
INSTAGRAM_COOKIES_FILE=
INSTAGRAM_APP_ID=936619743392459

# ===== لوحة مراقبة الأرقام وتنبيهات تيليجرام الفورية =====
# تفعيل المراقب بالكامل
ALERT_ENABLED=true
# فترة التحقق من صحة الجلسات (مللي ثانية) — الافتراضي 30 ثانية
ALERT_MONITOR_INTERVAL_MS=30000
# عتبة تنبيه الانفصال (مللي ثانية) — الافتراضي 60 ثانية على عدم اتصال
ALERT_DISCONNECT_THRESHOLD_MS=60000
# عتبة تنبيه التوقف (مللي ثانية) — الافتراضي 3 دقائق بلا نشاط
ALERT_STALL_THRESHOLD_MS=180000
# تبريد التنبيهات (مللي ثانية) — لتجنب الإغراق
ALERT_COOLDOWN_MS=300000
# مهلة طلبات Bot API
TELEGRAM_ALERTS_TIMEOUT_MS=10000
# بوت منفصل للتنبيهات (اختياري — يستخدم TELEGRAM_TOKEN و DEVELOPER_ID افتراضياً)
# TELEGRAM_ALERTS_BOT_TOKEN=
# TELEGRAM_ALERTS_CHAT_ID=
# تفعيل لوحة الموقع للمراقبة
MONITOR_DASHBOARD_ENABLED=true
